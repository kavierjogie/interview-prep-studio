# Server-side only. Never prefix this with NEXT_PUBLIC_ and never commit a real key.
# Get a key at https://console.groq.com/keys and add it to Vercel → Project → Settings → Environment Variables.
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the Groq model used for analysis (defaults to openai/gpt-oss-120b).
# GROQ_MODEL=openai/gpt-oss-120b
